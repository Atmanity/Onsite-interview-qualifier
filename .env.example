# Anthropic API key — powers JD curation and candidate assessment.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for curation + assessment. Defaults to the most capable model.
# Override with claude-sonnet-4-6 for lower cost if you prefer.
ASSESSMENT_MODEL=claude-opus-4-8

# SQLite database location (Prisma).
DATABASE_URL="file:./dev.db"
